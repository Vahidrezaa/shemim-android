<?xml version="1.0" encoding="utf-8"?>
<!--
  صفحهٔ ورود — بازنویسی اساسی (WP-0.3) با ویجت‌های کلاسیک فریم‌ورک، نه Compose.

  دلیل تغییر فناوری رندر: گزارش‌های دو روز اخیر روی گوشی واقعی نشان داد حتی
  پریمیتیوهای سادهٔ Compose (BasicTextField/Box با background صریح) پس از
  اولین فریم پایدار رنگ نمی‌شوند — در حالی که اسپلش، کیبورد و همهٔ رابط
  سیستمی همان گوشی با پایپ‌لاین View رندر می‌شوند. صفحهٔ ورود به‌همین دلیل
  به View محور منتقل شد: EditText/Button/TextView بدون هیچ رنگ وابسته به
  تم/ColorScheme — همهٔ رنگ‌ها literal هستند.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFDF9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="64dp"
        android:paddingBottom="32dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/text_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_brand_fund"
            android:textSize="13sp"
            android:textColor="#6B7F76"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_title"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#16332A"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/label_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_gravity="start"
            android:text="@string/auth_username_label"
            android:textSize="13sp"
            android:textColor="#6B7F76" />

        <EditText
            android:id="@+id/edit_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/field_bg"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:textSize="16sp"
            android:textColor="#1F2A26"
            android:textColorHint="#A9B8B1" />

        <TextView
            android:id="@+id/label_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="start"
            android:text="@string/auth_password_label"
            android:textSize="13sp"
            android:textColor="#6B7F76" />

        <EditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/field_bg"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:textSize="16sp"
            android:textColor="#1F2A26"
            android:textColorHint="#A9B8B1" />

        <TextView
            android:id="@+id/toggle_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_gravity="end"
            android:padding="8dp"
            android:text="@string/auth_show_password"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1A6B52" />

        <TextView
            android:id="@+id/text_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:textSize="14sp"
            android:textColor="#B3261E"
            android:textAlignment="center" />

        <Button
            android:id="@+id/button_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/login_button_bg"
            android:stateListAnimator="@null"
            android:text="@string/auth_submit"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />

        <ProgressBar
            android:id="@+id/progress_login"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/auth_offline_hint"
            android:textSize="12sp"
            android:textColor="#8A9B93"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/text_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="11sp"
            android:textColor="#A9B8B1"
            android:textAlignment="center" />

    </LinearLayout>

</ScrollView>
